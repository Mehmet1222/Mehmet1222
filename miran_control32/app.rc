      VALUE "InternalName", "MiranControl32\0"
      VALUE "OriginalFilename", "MiranControl32.exe\0"
      VALUE "ProductName", "Miran Control\0"
      VALUE "ProductVersion", "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
